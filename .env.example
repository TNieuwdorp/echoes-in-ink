# Local vLLM server (default). Any OpenAI-compatible endpoint works here.
# ECHOES_LOCAL_MODEL is the --served-model-name of a preset in scripts/serve_vllm.sh.
ECHOES_LOCAL_BASE_URL=http://localhost:8000/v1
ECHOES_LOCAL_MODEL=qwen38
# Optional cloud fallbacks. Leave empty to keep everything local.
# Claude needs no key: `--engine claude` uses the logged-in Claude Code CLI (`claude auth status`).
# Set ANTHROPIC_API_KEY only to bill the API instead of the subscription.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
